# VTM Noble — local / package artifacts (do not push)
.venv/
.venv-build/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Builds
build/
dist/
*.egg-info/

# Node
ui/node_modules/
ui/dist/
ui/public/_early_splash.html

# Runtime outputs / logs
outputs/
*.log
vtm_noble.log
real_stream.log

# torch.compile / Triton kernel cache
models/cache/

# DiT weights (download into models/dit — never commit)
models/dit/**
!models/dit/.gitkeep
models/iamge/

# User refs + local picker state
models/refs/**
!models/refs/.gitkeep
characters/**
!characters/.gitkeep
models/blendshapes/**
!models/blendshapes/.gitkeep
models/*.lock
models/extra_checkpoint_dirs.json
models/session.json

# Leftover pre-layout folder
/data/

# Large caches
**/__pycache__/

# Prefer models/trackers (downloaded from HF). Skip duplicate vendor copies.
vendor/tools/live-poser/models/*.pt
vendor/tools/live-poser/models/*.onnx
vendor/tools/live-poser/models/*.task
vendor/tools/pose-traker/**/iris_pose.pt
vendor/tools/pose-traker/**/dwpose_v2.pt
vendor/tools/pose-traker/**/dwpose_v2.onnx

# Local uv bootstrap (Smart Build downloads Astral uv here if PATH has none)
.tools/

# Isolated face-tracking lab (local venv + UI build).
# Weights live in models/trackers and vendor/tools/openseeface/models.
track_lab/.venv/
track_lab/ui/node_modules/
track_lab/ui/dist/
track_lab/models/*
!track_lab/models/.gitkeep
track_lab/output/
track_lab/input/*
!track_lab/input/.gitkeep

# Tracker weights download via install.bat (models/model_sources.json)
models/trackers/*.pt
models/trackers/*.pth
models/trackers/*.onnx
models/trackers/*.task
